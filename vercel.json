{
  "rewrites": [
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/lets-work",
      "destination": "/lets-work.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portfolio.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lets-work",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lets-work.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/start.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
